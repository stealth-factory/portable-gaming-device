---
/* One page per game (/tunnel-raider, /dino-run …): the same console, booting straight into that disk. */
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import { DISKS } from '../games/registry';

export function getStaticPaths(){
  return DISKS.map(d => ({ params: { slug: d.slug }, props: { id: d.id, slug: d.slug, title: d.page.title, description: d.page.description } }));
}
const { id, slug, title, description } = Astro.props;
// each game's share image is public/og-<slug>.png (made by tools/share-images/make.cjs)
---
<ConsoleLayout title={title} description={description} autoload={id}
  ogImage={`/og-${slug}.png`} ogAlt={`${title} on the PGD-01 Portable Gaming Device, a 1983-style console on a green-phosphor CRT monitor.`} />
