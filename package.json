{
  "name": "portable-gaming-device",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.14.1",
  "type": "module",
  "description": "PGD-01 Portable Gaming Device: a 1983-style browser game console. Install from git for <PGDConsole>, its React component.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-factory/portable-gaming-device.git"
  },
  "exports": {
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "react/",
    "LICENSE",
    "LICENSES/",
    "LICENSING.md"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build && node tools/disks/build.mjs",
    "preview": "astro preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@vite-pwa/astro": "^2.0.1",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
