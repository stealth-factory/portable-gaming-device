{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/disks/v1/(.*)\\.pgdisk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        }
      ]
    },
    {
      "source": "/disks/v1/index.json(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
